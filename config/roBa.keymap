#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 65

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    scroll-layers = <3>;

    // レイヤー2(window-control)中にボールを転がすとウィンドウ操作
    // 並び順: 右, 左, 上, 下

    gesture {
        layers = <2>;
        bindings =
            <&kp LC(LA(LG(RIGHT_ARROW)))>,
            <&kp LC(LA(LG(LEFT_ARROW)))>,
            <&kp LC(LA(LG(UP_ARROW)))>,
            <&kp LC(LA(LG(DOWN_ARROW)))>;

        tick = <150>;
        wait-ms = <300>;
        tap-ms = <5>;
    };

    // レイヤー1(スペース長押し)中にボールを上下で拡大・縮小
    // 左右には何も割り当てない(横のブレは捨てる)
    zoom {
        layers = <1>;
        bindings =
            <&none>,
            <&none>,
            <&kp LC(EQUAL)>,
            <&kp LC(MINUS)>;

        tick = <100>;
        wait-ms = <5>;
        tap-ms = <5>;
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        left-click {
            bindings = <&mkp LCLK>;
            key-positions = <18 19>;
        };

        middle-click {
            bindings = <&mkp MCLK>;
            key-positions = <18 19 20>;
        };

        right-click {
            bindings = <&mkp RCLK>;
            key-positions = <19 20>;
        };

        prev-click {
            bindings = <&mkp MB4>;
            key-positions = <30 31>;
        };

        next-click {
            bindings = <&mkp MB5>;
            key-positions = <31 32>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        // 単体押し:BS / 長押し:レイヤー4 / 1回押してすぐ長押し:BS連打

        lt_bs: lt_bs {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            bindings = <&mo>, <&kp>;
        };

        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        encoder_msc_down_up: encoder_msc_down_up {
            compatible = "zmk,behavior-sensor-rotate";
            label = "ENCODER_MSC_DOWN_UP";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            // 追加: スクロールのタップ時間を設定 (20ms)

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q    &kp L   &kp U   &kp COMMA  &kp PERIOD                                                      &kp F        &kp W  &kp R    &kp Y  &kp P
&lt 3 E  &kp I   &kp A   &kp O      &kp MINUS           &mkp MCLK                  &kp LC(LS(TAB))  &kp K        &kp T  &lt 2 N  &kp S  &lt 3 H
&kp Z    &kp X   &kp C   &kp V      &kp QUESTION        &kp KP_NUMBER_2            &kp LC(TAB)      &kp G        &kp D  &kp M    &kp J  &kp B
&trans   &trans  &trans  &kp TAB    &lt_bs 4 BACKSPACE  &mt LEFT_SHIFT DELETE      &lt 2 ENTER      &lt 1 SPACE                         &kp ESCAPE
            >;

            sensor-bindings = <&encoder_msc_down_up>;
        };

        ARROW-NUM {
            bindings = <
&kp ASTERISK  &kp N1        &kp N2        &kp N3        &kp PLUS                           &kp LG(LA(R))  &trans          &kp UP_ARROW    &trans           &kp LG(PRINTSCREEN)
&kp NUMBER_0  &kp N4        &kp NUMBER_5  &kp N6        &kp MINUS  &trans          &trans  &kp HOME       &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp END
&kp KP_SLASH  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp EQUAL  &kp KP_DOT      &trans  &kp C_BRI_DN   &kp C_VOL_DN    &kp C_MUTE      &kp C_VOLUME_UP  &kp C_BRI_UP
&trans        &trans        &trans        &kp LANG2     &kp LANG1  &trans          &trans  &trans                                                          &kp K_SLEEP
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        window-control {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans       &trans  &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &kp LG(TAB)  &trans  &kp LG(D)  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans       &trans  &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                  &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                          &trans   &trans             &trans      &trans           &trans
&trans  &trans  &trans  &trans  &trans  &kp C_MUTE      &trans  &trans   &kp C_VOLUME_DOWN  &kp C_MUTE  &kp C_VOLUME_UP  &trans
&trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans   &trans             &trans      &trans           &trans
&trans  &trans  &trans  &trans  &trans  &trans          &trans  &kp TAB                                                  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        NUM {
            bindings = <
&kp ASTERISK     &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp PLUS                                                 &kp CARET         &kp AMPERSAND      &kp TILDE       &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&kp KP_NUMBER_0  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp MINUS   &kp LC(LA(KP_NUMBER_0))      &kp UNDERSCORE  &kp EXCLAMATION   &kp AT_SIGN        &kp HASH        &kp DOLLAR            &kp PERCENT
&kp SLASH        &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp PERIOD  &kp EQUAL                    &trans          &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LEFT_BRACE  &kp RIGHT_BRACE       &kp BACKSLASH
&trans           &trans           &trans           &trans           &trans      &trans                       &trans          &trans                                                                     &kp PIPE
            >;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                &trans
            >;
        };

        FUNCTION {
            bindings = <
&trans   &kp F1  &kp F2  &kp F3  &trans                      &trans  &kp F11  &kp F12  &kp F13  &trans
&kp F10  &kp F4  &kp F5  &kp F6  &trans  &trans      &trans  &trans  &kp F14  &kp F15  &kp F16  &kp F20
&trans   &kp F7  &kp F8  &kp F9  &trans  &trans      &trans  &trans  &kp F17  &kp F18  &kp F19  &trans
&trans   &trans  &trans  &trans  &trans  &trans      &trans  &trans                             &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans        &trans        &trans        &trans                           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans        &trans        &trans        &trans        &trans
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans  &trans      &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans                                                  &bt BT_CLR_ALL
            >;
        };
    };
};
