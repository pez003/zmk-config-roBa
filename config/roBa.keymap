#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 65

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

// エンコーダー: 1周12カチッ → 1カチッ=1入力

&left_encoder { steps = <48>; };

&sensors { triggers-per-rotation = <12>; };

&trackball {
    scroll-layers = <3>;

    // レイヤー2(window-control)中にボールを転がすとウィンドウ操作
    // 4方向ともCtrl+Alt+Win+矢印を送り、AutoHotkey(roba-window.ahk)が受け取って動かす
    // (左右はWindowsのスナップに変換、連続入力はAutoHotkey側で無視)
    // 並び順: 右, 左, 上, 下

    gesture {
        layers = <2>;
        bindings =
            <&kp LC(LA(LG(RIGHT_ARROW)))>,
            <&kp LC(LA(LG(LEFT_ARROW)))>,
            <&kp LC(LA(LG(UP_ARROW)))>,
            <&kp LC(LA(LG(DOWN_ARROW)))>;

        tick = <150>;
        wait-ms = <300>;
        tap-ms = <5>;
    };

    // レイヤー5(バックスペース/エンター長押し)中にボールを上下で拡大・縮小
    // 左右には何も割り当てない(横のブレは捨てる)

    zoom {
        layers = <5>;
        bindings = <&none>, <&none>, <&kp LC(EQUAL)>, <&kp LC(MINUS)>;

        tick = <100>;
        wait-ms = <5>;
        tap-ms = <5>;
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        left-click {
            bindings = <&mkp LCLK>;
            key-positions = <18 19>;
        };

        middle-click {
            bindings = <&mkp MCLK>;
            key-positions = <18 19 20>;
        };

        right-click {
            bindings = <&mkp RCLK>;
            key-positions = <19 20>;
        };

        prev-click {
            bindings = <&mkp MB4>;
            key-positions = <30 31>;
        };

        next-click {
            bindings = <&mkp MB5>;
            key-positions = <31 32>;
        };

        new-tab {
            bindings = <&kp LC(T)>;
            key-positions = <16 28>;
        };

        LANG_1 {
            bindings = <&kp LANG1>;
            key-positions = <19 41 18>;
        };

        LANG_2 {
            bindings = <&kp LANG2>;
            key-positions = <12 38 13>;
        };

        Mission_Control {
            bindings = <&kp LG(TAB)>;
            key-positions = <18 20>;
        };

        Show_Desktop {
            bindings = <&kp LG(D)>;
            key-positions = <20 30>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        kakko: kakko {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_PARENTHESIS &kp RIGHT_PARENTHESIS &kp LEFT_ARROW>;
            label = "KAKKO";
        };

        sleep: sleep {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_wait_time 300>,
                <&kp LANG2 &kp LG(X) &kp U &kp S>;

            label = "SLEEP";
        };

        sh_gobaku_taisaku: sh_gobaku_taisaku {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp S &kp H>;
            label = "SH_GOBAKU_TAISAKU";
        };

        night_modo: night_modo {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_wait_time 400>, <&kp LG(A) &kp SPACE &kp ESCAPE>;

            label = "NIGHT_MODO";
        };

        kagikakko: kagikakko {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LBKT &kp RBKT &kp LEFT_ARROW>;
            label = "KAGIKAKKO";
        };

        nami_kakko: nimi_kakko {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LBRC &kp RBRC &kp LEFT_ARROW>;
            label = "NIMI_KAKKO";
        };
    };

    behaviors {
        // 単体押し:BS / 長押し:レイヤー4 / 1回押してすぐ長押し:BS連打

        lt_bs: lt_bs {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            bindings = <&mo>, <&kp>;
        };

        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        encoder_msc_down_up: encoder_msc_down_up {
            compatible = "zmk,behavior-sensor-rotate";
            label = "ENCODER_MSC_DOWN_UP";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            // 追加: スクロールのタップ時間を設定 (20ms)

            tap-ms = <20>;
        };

        td_c: td_c {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_C";
            #binding-cells = <0>;
            bindings = <&mt LEFT_SHIFT C>, <&kp LC(C)>;
        };

        td_v: td_v {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_V";
            #binding-cells = <0>;
            bindings = <&mt LEFT_WIN V>, <&kp LC(V)>, <&kp LG(V)>;
        };

        td_x: td_x {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_X";
            #binding-cells = <0>;
            bindings = <&mt LEFT_ALT X>, <&kp LC(X)>;
        };

        td_z: td_z {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_Z";
            #binding-cells = <0>;
            bindings = <&mt LCTRL Z>, <&kp LC(Z)>, <&kp LC(Y)>;
        };

        td_question: td_question {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_QUESTION";
            #binding-cells = <0>;
            bindings = <&kp QUESTION>, <&kp LS(NUMBER_1)>;
        };

        td_plus_astrisk: td_plus_astrisk {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_PLUS_ASTRISK";
            #binding-cells = <0>;
            bindings = <&kp PLUS>, <&kp ASTRK>;
        };

        td_minus_slash: td_minus_slash {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_MINUS_SLASH";
            #binding-cells = <0>;
            bindings = <&kp KP_MINUS>, <&kp KP_SLASH>;
        };

        td_comma_dot: td_comma_dot {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_COMMA_DOT";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp DOT>;
        };

        td_kakko_kagikakko: td_kakko_kagikakko {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_KAKKO_KAGIKAKKO";
            #binding-cells = <0>;
            bindings = <&kakko>, <&kagikakko>;
        };

        td_MINUS_TILDE: td_MINUS_TILDE {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_MINUS_TILDE";
            #binding-cells = <0>;
            bindings = <&kp MINUS>, <&kp TILDE>;
        };

        td_slash_and_back_slash: td_slash_and_back_slash {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_SLASH_AND_BACK_SLASH";
            #binding-cells = <0>;
            bindings = <&kp KP_DIVIDE>, <&kp BACKSLASH>;
        };

        td_colon_and_semicolon: td_colon_and_semicolon {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_COLON_AND_SEMICOLON";
            #binding-cells = <0>;
            bindings = <&kp COLON>, <&kp SEMICOLON>;
        };

        td_quote_and_double_quote: td_quote_and_double_quote {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_QUOTE_AND_DOUBLE_QUOTE";
            #binding-cells = <0>;
            bindings = <&kp SINGLE_QUOTE>, <&kp DQT>;
        };

        td_num_dot_and_comma: td_num_dot_and_comma {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_NUM_DOT_AND_COMMA";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp KP_DOT>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&lt 7 Q  &kp L   &kp U   &td_comma_dot      &td_kakko_kagikakko                                              &kp F        &kp W            &kp R              &kp Y            &kp P
&kp E    &kp I   &kp A   &kp O              &td_MINUS_TILDE      &kp C_MUTE                 &kp LC(LS(TAB))  &kp K        &kp T            &lt 2 N            &lt 5 S          &lt 3 H
&td_z    &td_x   &td_c   &td_v              &td_question         &none                      &kp LC(TAB)      &kp G        &mt RIGHT_WIN D  &mt RIGHT_SHIFT M  &mt RIGHT_ALT J  &mt RCTRL B
&trans   &trans  &trans  &kp LC(BACKSPACE)  &lt_bs 4 BACKSPACE   &mt LEFT_SHIFT DELETE      &lt 8 ENTER      &lt 1 SPACE                                                       &kp ESCAPE
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        NUM_and_ARROW {
            bindings = <
&kp KP_NUMLOCK  &kp N1        &kp N2        &kp N3        &td_num_dot_and_comma                          &none     &none               &kp UP_ARROW    &none                &none
&kp NUMBER_0    &kp N4        &kp NUMBER_5  &kp N6        &td_plus_astrisk       &kp C_MUTE      &trans  &kp HOME  &kp LEFT_ARROW      &kp DOWN_ARROW  &kp RIGHT_ARROW      &kp END
&none           &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &td_minus_slash        &kp EQUAL       &trans  &none     &kp LC(LEFT_ARROW)  &none           &kp LC(RIGHT_ARROW)  &none
&trans          &trans        &trans        &trans        &trans                 &trans          &trans  &trans                                                             &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(C_VOL_DN) LC(C_VOL_UP)>;
        };

        TB_window-control {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans              &trans  &trans               &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &kp LG(LEFT_ARROW)  &trans  &kp LG(RIGHT_ARROW)  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans              &trans  &trans               &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                                   &trans
            >;
        };

        TB_SCROLL_and_TAB {
            bindings = <
&none  &none  &none  &none  &none                        &none    &none     &none  &none  &none
&none  &none  &none  &none  &none  &mkp MCLK      &none  &none    &kp HOME  &none  &none  &none
&none  &none  &none  &none  &none  &none          &none  &none    &kp END   &none  &none  &none
&none  &none  &none  &none  &none  &none          &none  &kp TAB                          &none
            >;

            sensor-bindings = <&encoder_msc_down_up>;
        };

        SYMBOL {
            bindings = <
&none     &none       &kp AMPERSAND  &none        &none                          &none                     &none          &kp CARET         &kp GRAVE                &none
&kp HASH  &kp DOLLAR  &kp AT         &kp PERCENT  &kp UNDER  &none       &none   &td_slash_and_back_slash  &nami_kakko    &kp SLASH         &td_colon_and_semicolon  &td_quote_and_double_quote
&none     &none       &none          &none        &none      &none       &none   &none                     &kp LESS_THAN  &kp GREATER_THAN  &kp PIPE                 &none
&trans    &trans      &trans         &trans       &trans     &trans      &trans  &trans                                                                              &none
            >;
        };

        tb_zoom {
            bindings = <
&trans  &trans  &trans  &trans  &trans                                &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &kp LC(NUMBER_0)      &trans  &trans  &none   &none   &none   &sh_gobaku_taisaku
&trans  &trans  &trans  &trans  &trans  &trans                &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                &trans  &trans                          &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(MINUS) LC(PLUS)>;
        };

        FUNCTION {
            bindings = <
&trans   &kp F1  &kp F2  &kp F3  &trans                      &trans  &kp F11  &kp F12  &kp F13  &trans
&kp F10  &kp F4  &kp F5  &kp F6  &trans  &trans      &trans  &trans  &kp F14  &kp F15  &kp F16  &kp F20
&trans   &kp F7  &kp F8  &kp F9  &trans  &trans      &trans  &trans  &kp F17  &kp F18  &kp F19  &trans
&trans   &trans  &trans  &trans  &trans  &trans      &trans  &trans                             &trans
            >;
        };

        bluetooth {
            bindings = <
&trans  &trans  &trans  &trans  &trans                           &none   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &none
&trans  &trans  &trans  &trans  &trans  &trans      &trans       &trans  &bt BT_SEL 3  &bt BT_SEL 4  &trans        &trans
&trans  &none   &none   &none   &trans  &trans      &bootloader  &trans  &trans        &trans        &trans        &bt BT_CLR
&trans  &trans  &trans  &trans  &trans  &trans      &trans       &trans                                            &bt BT_CLR_ALL
            >;
        };

        setting {
            bindings = <
&none  &none  &none  &none  &none                    &kp LS(LG(R))   &kp C_BRI_DN  &night_modo       &kp C_BRI_UP  &kp LG(PRINTSCREEN)
&none  &none  &none  &none  &none  &none      &none  &kp LC(LA(N4))  &kp C_VOL_DN  &kp C_MUTE        &kp C_VOL_UP  &kp LC(LA(N3))
&none  &none  &none  &none  &none  &none      &none  &none           &kp C_PREV    &kp C_PLAY_PAUSE  &kp C_NEXT    &kp LG(L)
&none  &none  &none  &none  &none  &none      &none  &none                                                         &sleep
            >;
        };

        LEFT_HAND {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };
    };
};
