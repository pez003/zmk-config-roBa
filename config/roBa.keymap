#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 65

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

// エンコーダー: 1周12カチッ → 1カチッ=1入力

&left_encoder { steps = <48>; };

&sensors { triggers-per-rotation = <12>; };

&trackball {
    scroll-layers = <3>;

    // レイヤー2(window-control)中にボールを転がすとウィンドウ操作
    // 並び順: 右, 左, 上, 下

    gesture {
        layers = <2>;
        bindings =
            <&kp LC(LA(LG(RIGHT_ARROW)))>,
            <&kp LC(LA(LG(LEFT_ARROW)))>,
            <&kp LC(LA(LG(UP_ARROW)))>,
            <&kp LC(LA(LG(DOWN_ARROW)))>;

        tick = <150>;
        wait-ms = <300>;
        tap-ms = <5>;
    };

    // レイヤー5(バックスペース/エンター長押し)中にボールを上下で拡大・縮小
    // 左右には何も割り当てない(横のブレは捨てる)

    zoom {
        layers = <5>;
        bindings = <&none>, <&none>, <&kp LC(EQUAL)>, <&kp LC(MINUS)>;

        tick = <100>;
        wait-ms = <5>;
        tap-ms = <5>;
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        left-click {
            bindings = <&mkp LCLK>;
            key-positions = <18 19>;
        };

        middle-click {
            bindings = <&mkp MCLK>;
            key-positions = <18 19 20>;
        };

        right-click {
            bindings = <&mkp RCLK>;
            key-positions = <19 20>;
        };

        prev-click {
            bindings = <&mkp MB4>;
            key-positions = <30 31>;
        };

        next-click {
            bindings = <&mkp MB5>;
            key-positions = <31 32>;
        };

        new-tab {
            bindings = <&kp LC(T)>;
            key-positions = <16 28>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        kakko: kakko {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_PARENTHESIS &kp RIGHT_PARENTHESIS &kp LEFT_ARROW>;
            label = "KAKKO";
        };

        sleep: sleep {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_wait_time 300>,
                <&kp LANG2 &kp LG(X) &kp U &kp S>;

            label = "SLEEP";
        };
    };

    behaviors {
        // 単体押し:BS / 長押し:レイヤー4 / 1回押してすぐ長押し:BS連打

        lt_bs: lt_bs {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            bindings = <&mo>, <&kp>;
        };

        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        encoder_msc_down_up: encoder_msc_down_up {
            compatible = "zmk,behavior-sensor-rotate";
            label = "ENCODER_MSC_DOWN_UP";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            // 追加: スクロールのタップ時間を設定 (20ms)

            tap-ms = <20>;
        };

        td_c: td_c {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_C";
            #binding-cells = <0>;
            bindings = <&mt LEFT_ALT C>, <&kp LC(C)>;
        };

        td_v: td_v {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_V";
            #binding-cells = <0>;
            bindings = <&mt LEFT_SHIFT V>, <&kp LC(V)>, <&kp LG(V)>;
        };

        td_x: td_x {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_X";
            #binding-cells = <0>;
            bindings = <&mt LCTRL X>, <&kp LC(X)>;
        };

        td_z: td_z {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_Z";
            #binding-cells = <0>;
            bindings = <&mt LEFT_WIN Z>, <&kp LC(Z)>, <&kp LC(Y)>;
        };

        td_question: td_question {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_QUESTION";
            #binding-cells = <0>;
            bindings = <&kp QUESTION>, <&kp LS(NUMBER_1)>;
        };

        td_comma_kakko: td_comma_kakko {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_COMMA_KAKKO";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kakko>;
        };

        td_plus_astrisk: td_plus_astrisk {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_PLUS_ASTRISK";
            #binding-cells = <0>;
            bindings = <&kp PLUS>, <&kp ASTRK>;
        };

        td_minus_slash: td_minus_slash {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_MINUS_SLASH";
            #binding-cells = <0>;
            bindings = <&kp MINUS>, <&kp SLASH>;
        };

        td_comma_dot: td_comma_dot {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_COMMA_DOT";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp DOT>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&lt 7 Q  &kp L   &kp U   &td_comma_kakko  &kp PERIOD                                                      &kp F        &kp W              &kp R            &kp Y        &kp P
&lt 3 E  &kp I   &kp A   &kp O            &kp MINUS           &mkp MCLK                  &kp LC(LS(TAB))  &kp K        &kp T              &lt 2 N          &lt 5 S      &lt 3 H
&td_z    &td_x   &td_c   &td_v            &td_question        &none                      &kp LC(TAB)      &kp G        &mt RIGHT_SHIFT D  &mt RIGHT_ALT M  &mt RCTRL J  &mt RIGHT_WIN B
&trans   &trans  &trans  &kp TAB          &lt_bs 4 BACKSPACE  &mt LEFT_SHIFT DELETE      &lt 4 ENTER      &lt 1 SPACE                                                   &kp ESCAPE
            >;

            sensor-bindings = <&encoder_msc_down_up>;
        };

        ARROW-NUM {
            bindings = <
&none         &kp N1        &kp N2        &kp N3        &kp EQUAL                                    &kp LG(LA(R))   &kp C_BRI_DN    &kp UP_ARROW    &kp C_BRI_UP     &kp LG(PRINTSCREEN)
&kp NUMBER_0  &kp N4        &kp NUMBER_5  &kp N6        &td_plus_astrisk  &trans             &trans  &kp HOME        &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp END
&none         &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &td_minus_slash   &td_comma_dot      &trans  &kp LC(LA(N4))  &kp C_VOL_DN    &kp C_MUTE      &kp C_VOLUME_UP  &kp LC(LA(N3))
&trans        &trans        &trans        &kp LANG2     &kp LANG1         &trans             &trans  &trans                                                           &sleep
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        window-control {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans       &trans  &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &kp LG(TAB)  &trans  &kp LG(D)  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans       &trans  &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                  &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                          &trans   &trans             &trans      &trans           &trans
&trans  &trans  &trans  &trans  &trans  &kp C_MUTE      &trans  &trans   &kp C_VOLUME_DOWN  &kp C_MUTE  &kp C_VOLUME_UP  &trans
&trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans   &trans             &trans      &trans           &trans
&trans  &trans  &trans  &trans  &trans  &trans          &trans  &kp TAB                                                  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        NUM {
            bindings = <
&none            &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &none                                                     &none          &kp N1  &kp N2        &kp N3  &none
&kp KP_NUMBER_0  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp MINUS  &kp LC(LA(KP_NUMBER_0))      &td_plus_astrisk  &kp EQUAL      &kp N4  &kp NUMBER_5  &kp N6  &kp N0
&none            &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &none      &kp EQUAL                    &td_minus_slash   &td_comma_dot  &kp N7  &kp N8        &kp N9  &none
&trans           &trans           &trans           &trans           &trans     &trans                       &trans            &trans                                       &none
            >;
        };

        layer5 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &none   &none   &none   &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        FUNCTION {
            bindings = <
&trans   &kp F1  &kp F2  &kp F3  &trans                      &trans  &kp F11  &kp F12  &kp F13  &trans
&kp F10  &kp F4  &kp F5  &kp F6  &trans  &trans      &trans  &trans  &kp F14  &kp F15  &kp F16  &kp F20
&trans   &kp F7  &kp F8  &kp F9  &trans  &trans      &trans  &trans  &kp F17  &kp F18  &kp F19  &trans
&trans   &trans  &trans  &trans  &trans  &trans      &trans  &trans                             &trans
            >;
        };

        bluetooth {
            bindings = <
&trans  &trans  &trans  &trans  &trans                           &none   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &none
&trans  &trans  &trans  &trans  &trans  &trans      &trans       &trans  &bt BT_SEL 3  &bt BT_SEL 4  &trans        &trans
&trans  &none   &none   &none   &trans  &trans      &bootloader  &trans  &trans        &trans        &trans        &bt BT_CLR
&trans  &trans  &trans  &trans  &trans  &trans      &trans       &trans                                            &bt BT_CLR_ALL
            >;
        };
    };
};
