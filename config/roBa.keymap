#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 65

// OS設定を日本語キーボードのまま使うための変換定義（出典: note.com/kloir_z/n/n314e739f03a1）

#define JP_DQUOTE       AT                // "
#define JP_AMPERSAND    CARET             // &
#define JP_QUOTE        AMPERSAND         // '
#define JP_EQUAL        UNDER             // =
#define JP_CARET        EQUAL             // ^
#define JP_YEN          0x89              // ¥
#define JP_PLUS         COLON             // +
#define JP_TILDE        PLUS              // ~
#define JP_PIPE         LS(0x89)          // |
#define JP_AT           LEFT_BRACKET      // @
#define JP_COLON        SINGLE_QUOTE      // :
#define JP_ASTERISK     DOUBLE_QUOTES     // *
#define JP_BACKQUOTE    LEFT_BRACE        // `
#define JP_UNDERSCORE   LS(0x87)          // _
#define JP_LBRACKET     RIGHT_BRACKET     // [
#define JP_RBRACKET     BACKSLASH         // ]
#define JP_LPAREN       ASTERISK          // (
#define JP_RPAREN       LEFT_PARENTHESIS  // )
#define JP_LBRACE       RIGHT_BRACE       // {
#define JP_RBRACE       PIPE              // }

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    scroll-layers = <3>;

    // レイヤー2(window-control)中にボールを転がすとウィンドウ操作
    // 並び順: 右, 左, 上, 下

    gesture {
        layers = <2>;
        bindings =
            <&kp LC(LA(LG(RIGHT_ARROW)))>,
            <&kp LC(LA(LG(LEFT_ARROW)))>,
            <&kp LC(LA(LG(UP_ARROW)))>,
            <&kp LC(LA(LG(DOWN_ARROW)))>;

        tick = <100>;
        wait-ms = <300>;
        tap-ms = <5>;
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        left-click {
            bindings = <&mkp LCLK>;
            key-positions = <18 19>;
        };

        middle-click {
            bindings = <&mkp MCLK>;
            key-positions = <18 19 20>;
        };

        right-click {
            bindings = <&mkp RCLK>;
            key-positions = <19 20>;
        };

        prev-click {
            bindings = <&mkp MB4>;
            key-positions = <30 31>;
        };

        next-click {
            bindings = <&mkp MB5>;
            key-positions = <31 32>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        encoder_msc_down_up: encoder_msc_down_up {
            compatible = "zmk,behavior-sensor-rotate";
            label = "ENCODER_MSC_DOWN_UP";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            // 追加: スクロールのタップ時間を設定 (20ms)

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q    &kp L   &kp U   &kp COMMA  &kp PERIOD                                                   &kp F        &kp W  &kp R  &kp Y  &kp P
&lt 3 E  &kp I   &kp A   &kp O      &kp MINUS        &mkp MCLK                  &kp KP_NUMBER_3  &kp K        &kp T  &kp N  &kp S  &lt 3 H
&kp Z    &kp X   &kp C   &kp V      &kp QUESTION     &kp KP_NUMBER_2            &kp KP_NUMBER_4  &kp G        &kp D  &kp M  &kp J  &kp B
&trans   &trans  &trans  &kp TAB    &lt 4 BACKSPACE  &mt LEFT_SHIFT DELETE      &lt 2 ENTER      &lt 1 SPACE                       &kp ESCAPE
            >;

            sensor-bindings = <&encoder_msc_down_up>;
        };

        ARROW-NUM {
            bindings = <
&kp ASTERISK  &kp N1        &kp N2        &kp N3        &kp PLUS                           &trans    &trans               &kp UP_ARROW    &trans           &trans
&kp NUMBER_0  &kp N4        &kp NUMBER_5  &kp N6        &kp MINUS  &trans          &trans  &kp HOME  &kp LEFT_ARROW       &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp END
&kp KP_SLASH  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp EQUAL  &kp KP_DOT      &trans  &trans    &kp LS(LC(LA(TAB)))  &kp A           &kp LC(LA(TAB))  &trans
&trans        &trans        &trans        &kp LANG2     &kp LANG1  &trans          &trans  &trans                                                          &kp K_SLEEP
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        window-control {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans                      &kp LG(LA(LC(UP_ARROW)))    &trans                       &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &kp LG(LC(LA(LEFT_ARROW)))  &kp LG(LC(LA(DOWN_ARROW)))  &kp LG(LC(LA(RIGHT_ARROW)))  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans                      &kp LG(D)                   &trans                       &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                                                                       &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                          &trans   &trans             &trans      &trans           &trans
&trans  &trans  &trans  &trans  &trans  &kp C_MUTE      &trans  &trans   &kp C_VOLUME_DOWN  &kp C_MUTE  &kp C_VOLUME_UP  &trans
&trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans   &trans             &trans      &trans           &trans
&trans  &trans  &trans  &trans  &trans  &trans          &trans  &kp TAB                                                  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        NUM {
            bindings = <
&kp JP_ASTERISK  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp JP_PLUS                                                  &kp JP_CARET     &kp JP_AMPERSAND  &kp JP_TILDE   &kp JP_LPAREN  &kp JP_RPAREN
&kp KP_NUMBER_0  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp MINUS    &kp LC(LA(KP_NUMBER_0))      &kp JP_UNDERSCORE  &kp EXCLAMATION  &kp JP_AT         &kp HASH       &kp DOLLAR     &kp PERCENT
&kp SLASH        &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp PERIOD   &kp JP_EQUAL                 &trans             &kp JP_LBRACKET  &kp JP_RBRACKET   &kp JP_LBRACE  &kp JP_RBRACE  &kp JP_YEN
&trans           &trans           &trans           &trans           &trans       &trans                       &trans             &trans                                                           &kp JP_PIPE
            >;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                &trans
            >;
        };

        FUNCTION {
            bindings = <
&trans   &kp F1  &kp F2  &kp F3  &trans                      &trans  &kp F11  &kp F12  &kp F13  &trans
&kp F10  &kp F4  &kp F5  &kp F6  &trans  &trans      &trans  &trans  &kp F14  &kp F15  &kp F16  &kp F20
&trans   &kp F7  &kp F8  &kp F9  &trans  &trans      &trans  &trans  &kp F17  &kp F18  &kp F19  &trans
&trans   &trans  &trans  &trans  &trans  &trans      &trans  &trans                             &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans        &trans        &trans        &trans                           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans        &trans        &trans        &trans        &trans
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans  &trans      &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans                                                  &bt BT_CLR_ALL
            >;
        };
    };
};
